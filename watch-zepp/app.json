              "path": "app-widget/index",
              "icon": "icon.png",
              "name": "URQENIX",
              "runtime": {
                "type": "js"
              }
            }
          ]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
