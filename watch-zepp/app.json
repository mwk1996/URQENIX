{
  "configVersion": "v3",
  "app": {
    "appId": 9990145,
    "appName": "URQENIX",
    "appType": "app",
    "version": {
      "code": 10404,
      "name": "1.4.4"
    },
    "icon": "icon.png",
    "vender": "URQENIX",
    "description": "URQENIX on your wrist: start a routine, log sets with the crown, rest with a ring. Pairs with your own URQENIX server."
